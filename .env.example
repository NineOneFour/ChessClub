# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://terry@localhost/chessclub

# --- Public origin --------------------------------------------------------
# The URL members reach the club at. Used to build invitation links and to
# decide whether session cookies are marked Secure. TLS is terminated
# upstream (reverse proxy), so this is https even though the app serves http.
PUBLIC_ORIGIN=https://chess.vsakis.com

# --- Realtime service -----------------------------------------------------
# Port the standalone WebSocket service listens on.
REALTIME_PORT=3001
# WebSocket URL the browser should connect to. Leave EMPTY in production:
# the client then derives wss://<current-host>/ws, which the upstream proxy
# must route to the realtime service. Set explicitly in local development.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3001

# --- Admin bootstrap (npm run seed:admin) ---------------------------------
ADMIN_USERNAME=terry
ADMIN_PASSWORD=change-me-before-first-run
ADMIN_REAL_NAME=Terry

# --- Analysis worker -------------------------------------------------------
# Stockfish, spoken to over a pipe. Leave empty to use `stockfish` on the PATH,
# or point it at a binary. Note that Stockfish is NOT in the Arch/Manjaro
# repositories: install from the AUR (yay -S stockfish) or build it from the
# official source, which needs no root. See the README.
STOCKFISH_PATH=
# Search depth per position. Higher is slower and no more use here; 16 is
# plenty for children's games and keeps an analysis reproducible.
ANALYSIS_DEPTH=16
# How often the worker looks for something to do, in milliseconds.
ANALYSIS_POLL_MS=5000

# --- Coaching (Groq) --------------------------------------------------------
# Post-game LLM summaries, generated by the analysis worker after Stockfish
# finishes. Leave GROQ_API_KEY empty to run without coaching summaries —
# Stockfish analysis, ratings, and everything else work identically either way.
GROQ_API_KEY=
# Defaults to openai/gpt-oss-120b if unset.
GROQ_MODEL=
